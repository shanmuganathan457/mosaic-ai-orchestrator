# Example environment configuration for MOSAIC AI Orchestrator

# LLM Provider Configuration: 'mock', 'ollama', or 'gemini'
LLM_PROVIDER=mock
LLM_MODEL=mock-deterministic-v1

# Local Ollama Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini API Provider Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Global LLM Execution Toggle
LLM_ENABLED=false
